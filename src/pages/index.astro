---
import Layout from "@/layouts/Layout.astro";
import Education from "@/components/sections/Education.astro";
import Experience from "@/components/sections/Experience.astro";
import Hero from "@/components/sections/Hero.astro";
import Skills from "@/components/sections/Skills.astro";
import References from "@/components/sections/References.astro";
import DownloadPDF from "@/components/DownloadPDF.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";

import { basics } from "@cv";
const { name, label, location } = basics;
---

<Layout title={`${name} · ${label} | ${location.city}, ${location.region}`}>
  <ThemeToggle />

  <main>
    <Hero class="section-card" />
    <Experience class="section-card" />
    <Education class="section-card" />
    <Skills class="section-card" />
    <References class="section-card" />
  </main>

  <DownloadPDF />
</Layout>

<style>
  main {
    padding: var(--sp-8) var(--sp-4);
    margin: 0 auto;
    width: 100%;
    max-width: 1020px;
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
  }

  @media (max-width: 900px) {
    main {
      padding: var(--sp-6) var(--sp-4);
      gap: var(--sp-4);
    }
  }

  @media (max-width: 600px) {
    main {
      padding: var(--sp-4) var(--sp-3);
      gap: var(--sp-3);
    }
  }
</style>
