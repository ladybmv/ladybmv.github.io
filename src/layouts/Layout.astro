---
import { basics } from "@cv"

interface Props {
  title: string
}

const { title } = Astro.props
const { image, summary, url } = basics
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="description" content={summary} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="preload" as="image" href={image} />

    <meta property="og:url" content={url} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={summary} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta name="twitter:description" content={summary} />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    /* Surfaces: Slate Dark */
    --bg-base: #0b0e14;
    --bg-card: #111622;
    --bg-elevated: #161e2e;
    --bg-overlay: rgba(11, 14, 20, 0.85);

    /* Borders */
    --border-subtle: rgba(255, 255, 255, 0.06);
    --border-default: rgba(123, 180, 236, 0.16);
    --border-hover: rgba(123, 180, 236, 0.38);
    --border-card: rgba(123, 180, 236, 0.10);

    /* Text */
    --text-primary: #f1f5f9;
    --text-secondary: #94a3b8;
    --text-tertiary: #64748b;
    --text-muted: #64748b;

    /* Technical Accents: Pastel Blue */
    --accent: #e2e8f0;
    --accent-subtle: rgba(123, 180, 236, 0.08);
    --accent-primary: #7bb4ec;
    --accent-primary-hover: #93c5fd;
    --accent-primary-subtle: rgba(123, 180, 236, 0.12);
    --accent-primary-border: rgba(123, 180, 236, 0.25);

    /* Type Scale */
    --fs-xs: 0.75rem;
    --fs-sm: 0.875rem;
    --fs-base: 1rem;
    --fs-lg: 1.125rem;
    --fs-xl: 1.25rem;
    --fs-2xl: 1.5rem;
    --fs-3xl: 2rem;
    --fs-4xl: 2.5rem;
    --fs-display: 2.75rem;

    /* Spacing */
    --sp-1: 0.25rem;
    --sp-2: 0.5rem;
    --sp-3: 0.75rem;
    --sp-4: 1rem;
    --sp-6: 1.5rem;
    --sp-8: 2rem;
    --sp-12: 3rem;

    /* Radii */
    --radius-sm: 6px;
    --radius-md: 10px;
    --radius-lg: 14px;
    --radius-xl: 18px;
    --radius-full: 9999px;

    /* Transitions */
    --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
    --duration-fast: 150ms;
    --duration-normal: 250ms;
  }

  html {
    font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    background: var(--bg-base);
    color: var(--text-primary);
    letter-spacing: -0.015em;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  ::-webkit-scrollbar {
    width: 6px;
    height: 6px;
  }

  ::-webkit-scrollbar-thumb {
    background-color: rgba(255, 255, 255, 0.15);
    border-radius: 9999px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background-color: rgba(255, 255, 255, 0.25);
  }

  ::-webkit-scrollbar-track {
    background-color: transparent;
  }

  body,
  figure {
    margin: 0;
    padding: 0;
  }

  a {
    text-decoration: none;
    color: inherit;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  h1,
  h2,
  h3,
  h4 {
    margin: 0;
    font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    color: var(--text-primary);
  }

  p {
    color: var(--text-secondary);
    font-size: var(--fs-sm);
    line-height: 1.6;
    margin: 0;
    text-wrap: pretty;
  }

  .print {
    display: none !important;
  }

  @page {
    size: A4 portrait;
    margin: 10mm 14mm;
  }

  @media print {
    :root {
      --bg-base: #ffffff;
      --bg-card: #ffffff;
      --bg-elevated: #ffffff;
      --border-card: transparent;
      --border-default: #d1d5db;
      --border-subtle: #e5e7eb;
      --text-primary: #000000;
      --text-secondary: #27272a;
      --text-tertiary: #52525b;
      --text-muted: #4b5563;
      --accent: #000000;
      --accent-primary: #000000;
      --fs-base: 0.95rem;
      --fs-sm: 0.825rem;
      --fs-xs: 0.72rem;
    }

    .no-print {
      display: none !important;
    }

    .print {
      display: block !important;
    }

    html {
      background: #ffffff !important;
      color: #000000 !important;
      font-size: 13px !important;
    }

    body {
      padding: 0 !important;
      margin: 0 !important;
      background: #ffffff !important;
    }

    astro-dev-toolbar {
      display: none !important;
    }

    main {
      padding: 0 !important;
      display: flex !important;
      flex-direction: column !important;
      gap: 0.75rem !important;
      max-width: 100% !important;
    }

    section {
      border: none !important;
      background: transparent !important;
      padding: 0.4rem 0 !important;
      margin: 0 !important;
      break-inside: avoid;
      page-break-inside: avoid;
    }

    article {
      break-inside: avoid;
      page-break-inside: avoid;
      box-shadow: none !important;
    }

    h1, h2, h3, h4, p, span, li, time {
      color: #000000 !important;
      -webkit-text-fill-color: #000000 !important;
      background: transparent !important;
      text-shadow: none !important;
    }
  }
</style>
