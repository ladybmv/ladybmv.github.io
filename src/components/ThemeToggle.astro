---
// ThemeToggle.astro - Botón interactivo y translúcido para alternar entre Dark Mode y Light Mode
---

<button
  id="theme-toggle-btn"
  class="no-print"
  type="button"
  aria-label="Alternar modo claro / oscuro"
  title="Alternar modo claro / oscuro"
>
  <!-- Icono Sol (se muestra en Dark Mode para cambiar a Light) -->
  <svg
    class="theme-icon sun-icon"
    xmlns="http://www.w3.org/2000/svg"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2"></path>
    <path d="M12 20v2"></path>
    <path d="m4.93 4.93 1.41 1.41"></path>
    <path d="m17.66 17.66 1.41 1.41"></path>
    <path d="M2 12h2"></path>
    <path d="M20 12h2"></path>
    <path d="m6.34 17.66-1.41 1.41"></path>
    <path d="m19.07 4.93-1.41 1.41"></path>
  </svg>

  <!-- Icono Luna (se muestra en Light Mode para cambiar a Dark) -->
  <svg
    class="theme-icon moon-icon"
    xmlns="http://www.w3.org/2000/svg"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
  </svg>
</button>

<script>
  function setupThemeToggle() {
    const btn = document.getElementById("theme-toggle-btn");
    if (!btn) return;

    btn.addEventListener("click", () => {
      const isCurrentlyLight = document.documentElement.classList.contains("light");

      if (isCurrentlyLight) {
        document.documentElement.classList.remove("light");
        document.documentElement.classList.add("dark");
        localStorage.setItem("theme", "dark");
      } else {
        document.documentElement.classList.remove("dark");
        document.documentElement.classList.add("light");
        localStorage.setItem("theme", "light");
      }
    });
  }

  // Inicializar al cargar y en cada navegación de cliente
  setupThemeToggle();
  document.addEventListener("astro:after-swap", setupThemeToggle);
</script>

<style>
  #theme-toggle-btn {
    position: fixed;
    top: var(--sp-6);
    right: var(--sp-6);
    width: 44px;
    height: 44px;
    border-radius: var(--radius-full);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    
    /* Glassmorphism Translúcido (no 100% opaco) */
    background: rgba(18, 21, 32, 0.45);
    border: 1px solid rgba(135, 150, 202, 0.28);
    color: var(--accent-primary);
    cursor: pointer;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.22);
    transition: all var(--duration-fast) var(--ease-out);
    z-index: 999;
    padding: 0;
  }

  #theme-toggle-btn:hover {
    border-color: var(--accent-primary);
    background: rgba(135, 150, 202, 0.22);
    transform: scale(1.06);
    box-shadow: 0 6px 24px rgba(135, 150, 202, 0.35);
  }

  #theme-toggle-btn:active {
    transform: scale(0.96);
  }

  /* Modo Claro Translúcido */
  :global(html.light) #theme-toggle-btn {
    background: rgba(255, 255, 255, 0.65);
    border-color: rgba(135, 150, 202, 0.38);
    box-shadow: 0 4px 18px rgba(135, 150, 202, 0.18);
  }

  :global(html.light) #theme-toggle-btn:hover {
    background: rgba(255, 255, 255, 0.88);
    border-color: var(--accent-primary);
    box-shadow: 0 6px 24px rgba(135, 150, 202, 0.28);
  }

  .theme-icon {
    transition: transform var(--duration-fast) var(--ease-out);
  }

  /* Estado por defecto / Modo Oscuro: muestra el sol */
  :global(:root) .sun-icon,
  :global(html.dark) .sun-icon {
    display: block;
  }

  :global(:root) .moon-icon,
  :global(html.dark) .moon-icon {
    display: none;
  }

  /* Modo Claro: muestra la luna */
  :global(html.light) .sun-icon {
    display: none;
  }

  :global(html.light) .moon-icon {
    display: block;
    color: var(--accent-primary);
  }

  @media (max-width: 700px) {
    #theme-toggle-btn {
      top: var(--sp-4);
      right: var(--sp-4);
      width: 40px;
      height: 40px;
    }
  }

  @media print {
    #theme-toggle-btn {
      display: none !important;
    }
  }
</style>
