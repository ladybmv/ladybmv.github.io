---
import Section from "../Section.astro"
import Check from "@/icons/Check.astro"
import { work } from "@cv"

const { class: className } = Astro.props;
---

<Section title="Experiencia Laboral" class={`experience-section ${className || ''}`}>
  <ul class="jobs-list">
    {
      work.map(
        ({ name, startDate, endDate, duration, position, summary, highlights, url }) => {
          let dateDisplay = duration
          if (!dateDisplay && startDate) {
            const parsedStart = new Date(startDate)
            const startYear = !isNaN(parsedStart.getTime()) ? parsedStart.getFullYear() : startDate
            let endYear = "Actual"
            if (endDate) {
              const parsedEnd = new Date(endDate)
              endYear = !isNaN(parsedEnd.getTime()) ? parsedEnd.getFullYear().toString() : endDate
            }
            dateDisplay = `${startYear} — ${endYear}`
          }

          return (
            <li class="job-item">
              <article>
                <header class="job-header">
                  <div class="job-meta">
                    <h3>
                      {url ? (
                        <a href={url} title={`Ver ${name}`} target="_blank" rel="noopener noreferrer">
                          {name}
                        </a>
                      ) : (
                        <span>{name}</span>
                      )}
                    </h3>
                    <h4>{position}</h4>
                  </div>

                  {dateDisplay && (
                    <time datetime={startDate || ""}>
                      {dateDisplay}
                    </time>
                  )}
                </header>

                <div class="job-body">
                  <p>{summary}</p>
                  {
                    highlights && highlights.length > 0 && (
                      <ul class="highlights">
                        {highlights.map((highlight) => (
                          <li>
                            <Check />
                            <span>{highlight}</span>
                          </li>
                        ))}
                      </ul>
                    )
                  }
                </div>
              </article>
            </li>
          )
        }
      )
    }
  </ul>
</Section>

<style>
  .jobs-list {
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
  }

  .job-item article {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    padding-bottom: var(--sp-4);
    border-bottom: 1px solid var(--border-subtle);
  }

  .job-item:last-child article {
    border-bottom: none;
    padding-bottom: 0;
  }

  .job-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--sp-3);
  }

  .job-meta {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .job-meta h3 {
    font-size: var(--fs-base);
    font-weight: 600;
    color: var(--text-primary);
  }

  .job-meta h3 a {
    color: var(--text-primary);
  }

  .job-meta h3 a:hover {
    color: var(--accent-primary);
  }

  .job-meta h4 {
    color: var(--accent-primary);
    font-weight: 500;
    font-size: var(--fs-sm);
  }

  time {
    color: var(--accent-primary);
    background: var(--accent-primary-subtle);
    border: 1px solid var(--accent-primary-border);
    padding: 3px 10px;
    border-radius: var(--radius-sm);
    font-size: var(--fs-xs);
    font-weight: 500;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .job-body {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }

  .job-body p {
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .highlights {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--sp-2);
    margin-top: var(--sp-1);
    padding-top: var(--sp-3);
    border-top: 1px solid var(--border-subtle);
  }

  .highlights li {
    display: flex;
    align-items: flex-start;
    gap: var(--sp-2);
    padding: var(--sp-2) var(--sp-3);
    background: var(--bg-elevated);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-sm);
    font-size: var(--fs-xs);
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .highlights li:hover {
    border-color: var(--accent-primary-border);
    background: var(--accent-primary-subtle);
  }

  .highlights li :global(svg) {
    flex-shrink: 0;
    margin-top: 2px;
    color: var(--accent-primary);
  }

  @media (max-width: 700px) {
    .job-header {
      flex-direction: column;
      gap: var(--sp-2);
    }

    .highlights {
      grid-template-columns: 1fr;
    }
  }

  @media print {
    .jobs-list {
      gap: 0.65rem !important;
    }

    .job-item article {
      border-bottom: 1px solid #e5e7eb !important;
      padding-bottom: 0.4rem !important;
      break-inside: avoid;
      page-break-inside: avoid;
      gap: 4px !important;
    }

    .job-meta h3 {
      font-size: 0.95rem !important;
      color: #000 !important;
    }

    .job-meta h4 {
      color: #374151 !important;
      font-weight: 600 !important;
      font-size: 0.8rem !important;
    }

    time {
      background: transparent !important;
      border: none !important;
      color: #374151 !important;
      padding: 0 !important;
      font-weight: 600 !important;
      font-size: 0.75rem !important;
    }

    .job-body {
      gap: 4px !important;
    }

    .job-body p {
      font-size: 0.8rem !important;
      line-height: 1.4 !important;
      color: #333 !important;
    }

    .highlights {
      border-top: none !important;
      margin-top: 2px !important;
      padding-top: 0 !important;
      gap: 2px !important;
      grid-template-columns: 1fr !important;
    }

    .highlights li {
      background: transparent !important;
      border: none !important;
      padding: 1px 0 !important;
      color: #111 !important;
      font-size: 0.76rem !important;
      line-height: 1.35 !important;
    }

    .highlights li :global(svg) {
      color: #000 !important;
      width: 10px !important;
      height: 10px !important;
    }
  }
</style>
