---
import Section from "../Section.astro"
import { education, certificates } from "@cv"

const { class: className } = Astro.props;
---

<Section title="Formación & Cursos" class={`education-section ${className || ''}`}>
  <div class="edu-container">
    <div class="edu-group">
      <h3 class="group-title">Formación Académica</h3>
      <ul class="edu-list">
        {
          education.map(({ institution, startDate, endDate, area, studyType }) => {
            let years = ""
            if (startDate) {
              const parsedStart = new Date(startDate)
              const startYear = !isNaN(parsedStart.getTime()) ? parsedStart.getFullYear() : startDate
              let endYear = "Presente"
              if (endDate && endDate !== "null") {
                const parsedEnd = new Date(endDate)
                endYear = !isNaN(parsedEnd.getTime()) ? parsedEnd.getFullYear().toString() : endDate
              }
              years = `${startYear} — ${endYear}`
            }

            return (
              <li class="edu-item">
                <article>
                  <header class="edu-header">
                    <div class="edu-meta">
                      <h4>{institution}</h4>
                      <p class="edu-degree">{studyType} {area ? `· ${area}` : ''}</p>
                    </div>

                    {years && <time>{years}</time>}
                  </header>
                </article>
              </li>
            )
          })
        }
      </ul>
    </div>

    {
      certificates && certificates.length > 0 && (
        <div class="edu-group">
          <h3 class="group-title">Cursos & Certificaciones</h3>
          <ul class="cert-list">
            {certificates.map(({ name, issuer, date }) => (
              <li class="cert-item">
                <article>
                  <div class="cert-meta">
                    <h4>{name}</h4>
                    <p class="cert-issuer">{issuer}</p>
                  </div>
                  {date && <time>{date}</time>}
                </article>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</Section>

<style>
  .edu-container {
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
  }

  .edu-group {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }

  .group-title {
    font-size: var(--fs-xs);
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
    margin: 0;
    padding-bottom: 4px;
    border-bottom: 1px solid var(--border-subtle);
  }

  .edu-list,
  .cert-list {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }

  .edu-item article,
  .cert-item article {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--sp-2);
    padding: var(--sp-2) var(--sp-3);
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  .edu-item article:hover,
  .cert-item article:hover {
    border-color: var(--border-default);
  }

  .edu-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--sp-2);
    width: 100%;
  }

  .edu-meta,
  .cert-meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .edu-meta h4,
  .cert-meta h4 {
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.35;
  }

  .edu-degree,
  .cert-issuer {
    color: var(--text-secondary);
    font-size: var(--fs-xs);
    font-weight: 400;
    line-height: 1.4;
  }

  time {
    color: var(--text-tertiary);
    font-size: var(--fs-xs);
    font-weight: 500;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 700px) {
    .edu-header,
    .cert-item article {
      flex-direction: column;
      gap: 4px;
    }
  }

  @media print {
    .edu-container {
      gap: 1rem !important;
    }

    .group-title {
      border-bottom: 1px solid #e4e4e7 !important;
      color: #000 !important;
    }

    .edu-item article,
    .cert-item article {
      background: transparent !important;
      border: 1px solid #e4e4e7 !important;
      padding: 0.35rem 0.5rem !important;
      page-break-inside: avoid;
    }

    .edu-meta h4,
    .cert-meta h4 {
      color: #000 !important;
    }

    .edu-degree,
    .cert-issuer {
      color: #3f3f46 !important;
    }

    time {
      color: #52525b !important;
    }
  }
</style>
