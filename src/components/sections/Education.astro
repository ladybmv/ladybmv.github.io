---
import Section from "../Section.astro"
import { education, certificates } from "@cv"

const { class: className } = Astro.props;
---

<Section title="Formación & Cursos" class={`education-section ${className || ''}`}>
  <div class="edu-container">
    <div class="edu-group">
      <h3 class="group-title">Formación Académica</h3>
      <ul class="edu-list">
        {
          education.map(({ institution, startDate, endDate, area, studyType }) => {
            let years = ""
            if (startDate) {
              const parsedStart = new Date(startDate)
              const startYear = !isNaN(parsedStart.getTime()) ? parsedStart.getFullYear() : startDate
              let endYear = "Presente"
              if (endDate && endDate !== "null") {
                const parsedEnd = new Date(endDate)
                endYear = !isNaN(parsedEnd.getTime()) ? parsedEnd.getFullYear().toString() : endDate
              }
              years = `${startYear} — ${endYear}`
            }

            return (
              <li class="edu-item">
                <article>
                  <div class="edu-meta">
                    <h4>{institution}</h4>
                    <p class="edu-degree">{studyType} {area ? `· ${area}` : ''}</p>
                  </div>

                  {years && <time>{years}</time>}
                </article>
              </li>
            )
          })
        }
      </ul>
    </div>

    {
      certificates && certificates.length > 0 && (
        <div class="edu-group">
          <h3 class="group-title">Cursos & Certificaciones en Salud</h3>
          <ul class="cert-grid">
            {certificates.map(({ name, issuer, date }) => (
              <li class="cert-item">
                <article>
                  <div class="cert-meta">
                    <h4>{name}</h4>
                    <p class="cert-issuer">{issuer}</p>
                  </div>
                  {date && <time>{date}</time>}
                </article>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</Section>

<style>
  .edu-container {
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
  }

  .edu-group {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }

  .group-title {
    font-size: var(--fs-xs);
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 600;
    margin: 0;
    padding-bottom: var(--sp-2);
    border-bottom: 1px solid var(--border-default);
  }

  .edu-list {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }

  .cert-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--sp-3);
  }

  .edu-item article,
  .cert-item article {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--sp-3);
    padding: var(--sp-3) var(--sp-4);
    background: var(--bg-elevated);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-sm);
    height: 100%;
  }

  .edu-item article:hover,
  .cert-item article:hover {
    border-color: var(--accent-primary-border);
    background: var(--accent-primary-subtle);
    transform: translateY(-1px);
  }

  .edu-meta,
  .cert-meta {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .edu-meta h4,
  .cert-meta h4 {
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.35;
    margin: 0;
  }

  .edu-degree,
  .cert-issuer {
    color: var(--text-secondary);
    font-size: var(--fs-xs);
    font-weight: 400;
    line-height: 1.4;
    margin: 0;
  }

  time {
    color: var(--accent-primary);
    background: var(--accent-primary-subtle);
    border: 1px solid var(--accent-primary-border);
    font-size: var(--fs-xs);
    font-weight: 500;
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 700px) {
    .cert-grid {
      grid-template-columns: 1fr;
    }

    .edu-item article,
    .cert-item article {
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
    }
  }

  @media print {
    .cert-grid {
      grid-template-columns: repeat(2, 1fr) !important;
    }

    .group-title {
      border-bottom: 1px solid #e4e4e7 !important;
      color: #000 !important;
    }

    .edu-item article,
    .cert-item article {
      background: transparent !important;
      border: 1px solid #e4e4e7 !important;
      break-inside: avoid;
    }

    .edu-meta h4,
    .cert-meta h4 {
      color: #000 !important;
    }

    time {
      color: #374151 !important;
      background: transparent !important;
      border: none !important;
      font-weight: 600 !important;
      font-size: 0.75rem !important;
    }
  }
</style>
