---
import Section from "../Section.astro";
import Phone from "@/icons/Phone.astro";
import Mail from "@/icons/Mail.astro";
import type { References as RefType } from "@/cv";
import { references } from "@cv";

const { class: className } = Astro.props;

const refList = (references || []) as Array<RefType>;

const laboralRefs = refList.filter(
  (r) => r.type?.toLowerCase() === "laboral"
);

const personalRefs = refList.filter(
  (r) => r.type?.toLowerCase() !== "laboral"
);
---

{
  references && references.length > 0 && (
    <Section
      title="Referencias"
      class={`references-section ${className || ""}`}
    >
      <div class="references-container">
        {laboralRefs.length > 0 && (
          <div class="ref-group">
            <header class="group-header">
              <div class="group-title-row">
                <span class="group-indicator laboral"></span>
                <h3>Laborales</h3>
              </div>
              <span class="group-count">{laboralRefs.length} referencias</span>
            </header>

            <ul class="laboral-grid">
              {laboralRefs.map(
                ({ name, phone, title, company, area, email, reference }) => (
                  <li class="ref-item">
                    <article class="ref-card laboral-card">
                      <header class="ref-card-header">
                        <div class="ref-title-block">
                          <h4>{name}</h4>
                          {title && <span class="ref-position">{title}</span>}
                        </div>

                        {(company || area) && (
                          <div class="ref-company-tag">
                            {company && <span class="company-name">{company}</span>}
                            {company && area && <span class="sep">•</span>}
                            {area && <span class="area-name">{area}</span>}
                          </div>
                        )}
                      </header>

                      {reference && (
                        <div class="ref-quote">
                          <p>{reference}</p>
                        </div>
                      )}

                      <footer class="ref-card-footer">
                        {phone && (
                          <a
                            href={`tel:${phone}`}
                            class="action-chip phone"
                            title={`Llamar a ${name}`}
                            aria-label={`Llamar a ${name} al ${phone}`}
                          >
                            <Phone />
                            <span>{phone}</span>
                          </a>
                        )}

                        {email && (
                          <a
                            href={`mailto:${email}`}
                            class="action-chip email"
                            title={`Enviar correo a ${name}`}
                            aria-label={`Enviar correo a ${name}`}
                          >
                            <Mail />
                            <span>{email}</span>
                          </a>
                        )}
                      </footer>
                    </article>
                  </li>
                )
              )}
            </ul>
          </div>
        )}

        {personalRefs.length > 0 && (
          <div class="ref-group">
            <header class="group-header">
              <div class="group-title-row">
                <span class="group-indicator personal"></span>
                <h3>Personales</h3>
              </div>
              <span class="group-count">{personalRefs.length} referencias</span>
            </header>

            <ul class="personal-grid">
              {personalRefs.map(({ name, phone, reference }) => (
                <li class="ref-item">
                  <article class="ref-card personal-card">
                    <div class="personal-info">
                      <div class="personal-avatar" aria-hidden="true">
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          width="16"
                          height="16"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
                          <circle cx="12" cy="7" r="4" />
                        </svg>
                      </div>

                      <div class="personal-meta">
                        <h4>{name}</h4>
                        <span class="personal-rel">
                          {reference || "Referencia Personal"}
                        </span>
                      </div>
                    </div>

                    {phone && (
                      <a
                        href={`tel:${phone}`}
                        class="action-chip phone personal-phone"
                        title={`Llamar a ${name}`}
                        aria-label={`Llamar a ${name} al ${phone}`}
                      >
                        <Phone />
                        <span>{phone}</span>
                      </a>
                    )}
                  </article>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </Section>
  )
}

<style>
  .references-container {
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
  }

  .ref-group {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }

  /* ─── Group Headers ─── */
  .group-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: var(--sp-1);
    border-bottom: 1px solid var(--border-subtle);
  }

  .group-title-row {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
  }

  .group-title-row h3 {
    font-size: var(--fs-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-tertiary);
  }

  .group-indicator {
    width: 7px;
    height: 7px;
    border-radius: var(--radius-full);
  }

  .group-indicator.laboral {
    background-color: var(--accent-primary);
    box-shadow: 0 0 8px rgba(56, 189, 248, 0.5);
  }

  .group-indicator.personal {
    background-color: #a1a1aa;
  }

  .group-count {
    font-size: var(--fs-xs);
    color: var(--text-muted);
    font-weight: 400;
  }

  /* ─── Grids ─── */
  .laboral-grid,
  .personal-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--sp-4);
  }

  /* ─── Cards Base ─── */
  .ref-card {
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    transition:
      border-color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out);
  }

  .ref-card:hover {
    border-color: var(--border-default);
  }

  /* ─── Laboral Card ─── */
  .laboral-card {
    padding: var(--sp-4) var(--sp-5);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--sp-3);
    height: 100%;
  }

  .ref-card-header {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .ref-title-block {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .ref-title-block h4 {
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.3;
  }

  .ref-position {
    font-size: var(--fs-xs);
    font-weight: 500;
    color: var(--accent-primary);
    line-height: 1.4;
  }

  .ref-company-tag {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    font-size: var(--fs-xs);
    color: var(--text-tertiary);
  }

  .company-name {
    color: var(--text-secondary);
    font-weight: 500;
  }

  .sep {
    opacity: 0.5;
  }

  .area-name {
    color: var(--text-muted);
  }

  /* ─── Quote / Context Block ─── */
  .ref-quote {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.04);
    border-left: 2px solid var(--accent-primary);
    border-radius: var(--radius-sm);
    padding: var(--sp-2) var(--sp-3);
  }

  .ref-quote p {
    font-size: var(--fs-xs);
    line-height: 1.5;
    color: var(--text-secondary);
  }

  /* ─── Footer & Action Chips ─── */
  .ref-card-footer {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    margin-top: auto;
    padding-top: var(--sp-3);
    border-top: 1px solid var(--border-subtle);
  }

  .action-chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 6px 11px;
    border-radius: var(--radius-sm);
    font-size: var(--fs-xs);
    font-weight: 500;
    text-decoration: none;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    transition: all var(--duration-fast) var(--ease-out);
    font-family: inherit;
    font-variant-numeric: tabular-nums;
  }

  .action-chip:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: var(--border-default);
    color: var(--text-primary);
  }

  .action-chip.phone :global(svg) {
    width: 13px;
    height: 13px;
    color: var(--accent-primary);
    flex-shrink: 0;
  }

  .action-chip.email :global(svg) {
    width: 13px;
    height: 13px;
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .action-chip.email:hover :global(svg) {
    color: var(--text-primary);
  }

  /* ─── Personal Card (Compact & Balanced) ─── */
  .personal-card {
    padding: var(--sp-3) var(--sp-4);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--sp-3);
  }

  .personal-info {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    min-width: 0;
  }

  .personal-avatar {
    width: 32px;
    height: 32px;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: var(--text-tertiary);
  }

  .personal-meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .personal-meta h4 {
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .personal-rel {
    font-size: var(--fs-xs);
    color: var(--text-tertiary);
    font-weight: 400;
    line-height: 1.2;
  }

  .personal-phone {
    flex-shrink: 0;
  }

  /* ─── Responsive Media Queries ─── */
  @media (max-width: 768px) {
    .laboral-grid,
    .personal-grid {
      grid-template-columns: 1fr;
      gap: var(--sp-3);
    }

    .personal-card {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--sp-3);
    }

    .personal-phone {
      width: 100%;
      justify-content: center;
    }
  }

  /* ─── Print & PDF Optimization ─── */
  @media print {
    .references-container {
      gap: 1rem !important;
    }

    .group-header {
      border-bottom: 1px solid #e4e4e7 !important;
    }

    .group-title-row h3 {
      color: #000000 !important;
    }

    .group-indicator {
      display: none !important;
    }

    .laboral-grid,
    .personal-grid {
      display: grid !important;
      grid-template-columns: repeat(2, 1fr) !important;
      gap: 0.75rem !important;
      page-break-inside: avoid;
      break-inside: avoid;
    }

    .ref-card {
      background: transparent !important;
      border: 1px solid #e4e4e7 !important;
      box-shadow: none !important;
      page-break-inside: avoid;
      break-inside: avoid;
    }

    .ref-title-block h4,
    .personal-meta h4 {
      color: #000000 !important;
    }

    .ref-position {
      color: #27272a !important;
      font-weight: 600 !important;
    }

    .company-name,
    .area-name,
    .personal-rel {
      color: #52525b !important;
    }

    .ref-quote {
      background: transparent !important;
      border: 1px solid #e4e4e7 !important;
      border-left: 2px solid #000000 !important;
      padding: 0.25rem 0.5rem !important;
    }

    .ref-quote p {
      color: #3f3f46 !important;
    }

    .ref-card-footer {
      border-top: 1px solid #e4e4e7 !important;
      padding-top: 0.25rem !important;
    }

    .action-chip {
      background: transparent !important;
      border: 1px solid #e4e4e7 !important;
      color: #000000 !important;
      padding: 2px 6px !important;
    }

    .action-chip :global(svg),
    .personal-avatar {
      color: #000000 !important;
      background: transparent !important;
      border-color: #e4e4e7 !important;
    }
  }
</style>
