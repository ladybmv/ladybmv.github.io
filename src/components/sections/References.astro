---
import Section from "../Section.astro";
import Phone from "@/icons/Phone.astro";
import type { References as RefType } from "@/cv";
import { references } from "@cv";

const { class: className } = Astro.props;
const refList = (references || []) as Array<RefType>;

const laboralRefs = refList.filter(
  (r) => r.type?.toLowerCase() === "laboral" || r.type?.toLowerCase() === "profesional"
);

const personalRefs = refList.filter(
  (r) => r.type?.toLowerCase() !== "laboral" && r.type?.toLowerCase() !== "profesional"
);
---

{
  refList.length > 0 && (
    <Section title="Referencias" class={`references-section ${className || ""}`}>
      <div class="references-dual-columns">
        <!-- Columna 1: Laborales / Profesionales -->
        <div class="ref-col col-laboral">
          <header class="col-header">
            <div class="col-title-badge">
              <span class="status-dot laboral-dot"></span>
              <h3>Profesionales</h3>
            </div>
            <span class="count-pill">{laboralRefs.length} referencia{laboralRefs.length > 1 ? "s" : ""}</span>
          </header>

          <div class="col-cards-wrapper laboral-wrapper">
            {laboralRefs.map(({ name, title, company, phone, reference }) => (
              <article class="ref-card card-laboral">
                <div class="card-head-row">
                  <div class="card-identity">
                    <div class="ref-avatar avatar-laboral" aria-hidden="true">
                      <!-- Icono Maletín Profesional -->
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="17"
                        height="17"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <rect width="20" height="14" x="2" y="7" rx="2" />
                        <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" />
                      </svg>
                    </div>

                    <div class="identity-meta">
                      <span class="type-tag tag-laboral">Profesional</span>
                      <h4 class="person-name">{name}</h4>
                      <p class="person-title">
                        {title}
                        {company && <span class="company-name"> · {company}</span>}
                      </p>
                    </div>
                  </div>

                  {phone && (
                    <a
                      href={`tel:${phone}`}
                      class="contact-chip phone-chip"
                      title={`Llamar a ${name}`}
                      aria-label={`Llamar a ${name} al ${phone}`}
                    >
                      <Phone />
                      <span>{phone}</span>
                    </a>
                  )}
                </div>

                {reference && (
                  <div class="card-context-note">
                    <p class="quote-text">"{reference}"</p>
                  </div>
                )}
              </article>
            ))}
          </div>
        </div>

        <!-- Columna 2: Personales -->
        <div class="ref-col col-personal">
          <header class="col-header">
            <div class="col-title-badge">
              <span class="status-dot personal-dot"></span>
              <h3>Personales</h3>
            </div>
            <span class="count-pill">{personalRefs.length} referencias</span>
          </header>

          <div class="col-cards-wrapper personal-wrapper">
            {personalRefs.map(({ name, phone, title }) => (
              <article class="ref-card card-personal">
                <div class="card-identity">
                  <div class="ref-avatar avatar-personal" aria-hidden="true">
                    <!-- Icono Usuario -->
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
                      <circle cx="12" cy="7" r="4" />
                    </svg>
                  </div>

                  <div class="identity-meta">
                    <span class="type-tag tag-personal">Personal</span>
                    <h4 class="person-name">{name}</h4>
                    <span class="person-sub">{title || "Referencia Personal"}</span>
                  </div>
                </div>

                {phone && (
                  <a
                    href={`tel:${phone}`}
                    class="contact-chip phone-chip"
                    title={`Llamar a ${name}`}
                    aria-label={`Llamar a ${name} al ${phone}`}
                  >
                    <Phone />
                    <span>{phone}</span>
                  </a>
                )}
              </article>
            ))}
          </div>
        </div>
      </div>
    </Section>
  )
}

<style>
  .references-dual-columns {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--sp-6);
    align-items: stretch;
  }

  .ref-col {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    height: 100%;
  }

  /* Encabezados de Columna Simétricos */
  .col-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: var(--sp-2);
    border-bottom: 1px solid var(--border-default);
  }

  .col-title-badge {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
  }

  .col-title-badge h3 {
    font-size: var(--fs-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-tertiary);
    margin: 0;
  }

  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: var(--radius-full);
  }

  .status-dot.laboral-dot {
    background: var(--accent-primary);
    box-shadow: 0 0 8px rgba(135, 150, 202, 0.45);
  }

  .status-dot.personal-dot {
    background: var(--text-muted);
  }

  .count-pill {
    font-size: var(--fs-xs);
    color: var(--text-muted);
    font-weight: 400;
  }

  .col-cards-wrapper {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    flex: 1;
    height: 100%;
  }

  /* Tarjeta Base */
  .ref-card {
    background: var(--bg-elevated);
    border-radius: var(--radius-md);
  }

  /* Tarjeta Laboral / Profesional */
  .card-laboral {
    padding:.75rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--sp-3);
    border: 1px solid var(--accent-primary-border);
  }

  .card-laboral:hover {
    box-shadow: 0 4px 18px rgba(135, 150, 202, 0.15);
    transform: translateY(-1px);
  }

  .card-head-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--sp-3);
    width: 100%;
  }

  .card-identity {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    min-width: 0;
    flex: 1;
  }

  /* Avatares Simétricos */
  .ref-avatar {
    width: 38px;
    height: 38px;
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .avatar-laboral {
    background: var(--accent-primary-subtle);
    color: var(--accent-primary);
  }

  .avatar-personal {
    background: var(--bg-card);
    color: var(--text-muted);
    border: 1px solid var(--border-default);
  }

  .identity-meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .type-tag {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    padding: 2px 7px;
    border-radius: var(--radius-sm);
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 2px;
  }

  .tag-laboral {
    background: var(--accent-primary-subtle);
    color: var(--accent-primary);
    border: 1px solid var(--accent-primary-border);
  }

  .tag-personal {
    background: var(--accent-subtle);
    color: var(--text-muted);
    border: 1px solid var(--border-subtle);
  }

  .person-name {
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.3;
    margin: 0;
  }

  .person-title {
    font-size: var(--fs-xs);
    font-weight: 500;
    color: var(--accent-primary);
    margin: 0;
    line-height: 1.35;
  }

  .company-name {
    color: var(--text-secondary);
    font-weight: 400;
  }

  .person-sub {
    font-size: var(--fs-xs);
    color: var(--text-muted);
    line-height: 1.3;
  }

  .card-context-note {
    background: var(--accent-primary-subtle);
    border-left: 3px solid var(--accent-primary);
    border-radius: var(--radius-sm);
    padding: 0.55rem 0.85rem;
    margin-top: auto;
  }

  .quote-text {
    font-size: var(--fs-xs);
    line-height: 1.45;
    color: var(--text-secondary);
    margin: 0;
    font-style: italic;
  }

  /* Tarjeta Personal */
  .card-personal {
    padding: .75rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--sp-3);
    border: 1px solid var(--border-default);
    flex: 1;
  }

  .card-personal:hover {
    border-color: var(--accent-primary-border);
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(135, 150, 202, 0.10);
  }

  /* Chips de Contacto (Teléfono) */
  .contact-chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 12px;
    border-radius: var(--radius-sm);
    font-size: var(--fs-xs);
    font-weight: 500;
    text-decoration: none;
    background: var(--bg-card);
    border: 1px solid var(--border-default);
    color: var(--text-primary);
    font-family: inherit;
    font-variant-numeric: tabular-nums;
    flex-shrink: 0;
  }

  .contact-chip:hover {
    background: var(--accent-primary-subtle);
  }

  .contact-chip :global(svg) {
    width: 13px;
    height: 13px;
    color: var(--accent-primary);
    flex-shrink: 0;
  }

  /* Responsive */
  @media (max-width: 860px) {
    .references-dual-columns {
      grid-template-columns: 1fr;
      gap: var(--sp-6);
    }

    .card-head-row,
    .card-personal {
      flex-direction: row;
      align-items: center;
    }
  }

  @media (max-width: 600px) {
    .card-head-row,
    .card-personal {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--sp-3);
    }

    .contact-chip {
      width: 100%;
      justify-content: center;
    }
  }

  /* Impresión ATS A4 */
  @media print {
    .references-dual-columns {
      grid-template-columns: repeat(2, 1fr) !important;
      gap: 0.75rem !important;
    }

    .col-header {
      border-bottom: 1px solid #d1d5db !important;
      padding-bottom: 3px !important;
    }

    .col-title-badge h3 {
      color: #000 !important;
    }

    .status-dot,
    .count-pill {
      display: none !important;
    }

    .ref-card {
      background: transparent !important;
      border: 1px solid #d1d5db !important;
      box-shadow: none !important;
      break-inside: avoid;
      page-break-inside: avoid;
      padding: 6px 10px !important;
    }

    .card-laboral {
      min-height: auto !important;
      gap: 6px !important;
      padding: 6px 10px !important;
    }

    .type-tag {
      border: 1px solid #d1d5db !important;
      color: #333 !important;
      background: transparent !important;
      font-size: 0.6rem !important;
      padding: 1px 4px !important;
    }

    .person-name {
      color: #000 !important;
      font-size: 0.85rem !important;
    }

    .person-title {
      color: #333 !important;
      font-weight: 500 !important;
      font-size: 0.75rem !important;
    }

    .contact-chip {
      background: transparent !important;
      border: none !important;
      padding: 0 !important;
      color: #000 !important;
      font-size: 0.75rem !important;
    }

    .contact-chip :global(svg) {
      color: #000 !important;
      width: 11px !important;
      height: 11px !important;
    }

    .ref-avatar {
      display: none !important;
    }

    .card-context-note {
      background: transparent !important;
      border-left: 2px solid #9ca3af !important;
      padding: 2px 6px !important;
    }
  }
</style>
