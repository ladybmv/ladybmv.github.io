---
import { basics } from "@cv"
import Section from "@/components/Section.astro"
import Phone from "@/icons/Phone.astro"
import Mail from "@/icons/Mail.astro"
import WorldMap from "@/icons/WorldMap.astro"

const { name, label, image, location, phone, email, summary, cedula, age } = basics
const { city, region, address } = location

const printInfo = [
  cedula ? `C.I. ${cedula}` : null,
  age ? `Edad: ${age}` : null,
  phone ? `Telf: ${phone}` : null,
  email,
  [address, city, region].filter(Boolean).join(" - ")
].filter(Boolean).join(" • ")

const { class: className } = Astro.props;
---

<Section class={`hero-section ${className || ''}`}>
  <div class="container">
    <div class="info">
      <header class="hero-header">
        <h1>{name}</h1>
        <h2>{label}</h2>
      </header>

      <p class="summary">{summary}</p>

      <div class="meta-badges no-print">
        <div class="location-badge">
          <WorldMap />
          <span>{address ? `${address}, ` : ''}{city}, {region}</span>
        </div>
        {cedula && <span class="info-pill highlight">C.I. {cedula}</span>}
        {age && <span class="info-pill">{age}</span>}
      </div>

      <footer class="print">
        {printInfo}
      </footer>

      <footer class="no-print actions">
        {
          email && (
            <a
              href={`mailto:${email}`}
              title={`Enviar un correo a ${name} (${email})`}
              target="_blank"
              rel="noopener noreferrer"
              class="cta primary"
            >
              <Mail />
              <span>Contactar por Correo</span>
            </a>
          )
        }
        {
          phone && (
            <a
              href={`tel:${phone}`}
              title={`Llamar a ${name} al ${phone}`}
              class="cta secondary"
              rel="noopener noreferrer"
            >
              <Phone />
              <span>{phone}</span>
            </a>
          )
        }
      </footer>
    </div>

    <figure class="profile-figure">
      <img src={image} alt={name} width="128" height="128" />
    </figure>
  </div>
</Section>

<style>
  .hero-section {
    background: var(--bg-card);
  }

  .container {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-6);
  }

  .info {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    flex: 1;
  }

  .hero-header {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  h1 {
    font-size: var(--fs-3xl);
    line-height: 1.15;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--text-primary);
  }

  h2 {
    color: var(--accent-primary);
    font-weight: 500;
    font-size: var(--fs-base);
    line-height: 1.4;
  }

  .summary {
    color: var(--text-secondary);
    font-size: var(--fs-sm);
    line-height: 1.6;
    max-width: 95%;
  }

  .meta-badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-2);
  }

  .location-badge {
    color: var(--text-secondary);
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    font-size: var(--fs-xs);
    font-weight: 500;
  }

  .location-badge :global(svg) {
    color: var(--accent-primary);
  }

  .info-pill {
    display: inline-flex;
    align-items: center;
    background: var(--bg-elevated);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-sm);
    padding: 3px 9px;
    font-size: var(--fs-xs);
    font-weight: 500;
    color: var(--text-secondary);
  }

  .info-pill.highlight {
    background: var(--accent-primary-subtle);
    border-color: var(--accent-primary-border);
    color: var(--accent-primary);
  }

  .profile-figure {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  img {
    aspect-ratio: 1 / 1;
    object-fit: cover;
    width: 120px;
    height: 120px;
    border-radius: var(--radius-lg);
    border: 1px solid var(--accent-primary-border);
    background: var(--bg-elevated);
    transition: all var(--duration-fast) var(--ease-out);
  }

  img:hover {
    border-color: var(--accent-primary);
    box-shadow: 0 0 16px rgba(123, 180, 236, 0.2);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    margin-top: var(--sp-1);
    flex-wrap: wrap;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-2);
    height: 38px;
    padding: 0 var(--sp-4);
    border-radius: var(--radius-sm);
    font-size: var(--fs-xs);
    font-weight: 600;
    transition: all var(--duration-fast) var(--ease-out);
    text-decoration: none;
    cursor: pointer;
    font-family: inherit;
    white-space: nowrap;
  }

  .cta.primary {
    background: var(--accent-primary);
    color: #0b121d;
    border: 1px solid var(--accent-primary);
  }

  .cta.primary:hover {
    background: var(--accent-primary-hover);
    border-color: var(--accent-primary-hover);
    transform: translateY(-1px);
  }

  .cta.primary :global(svg) {
    color: #0b121d;
  }

  .cta.secondary {
    background: var(--bg-elevated);
    color: var(--text-primary);
    border: 1px solid var(--border-default);
  }

  .cta.secondary:hover {
    background: rgba(123, 180, 236, 0.08);
    border-color: var(--accent-primary);
    color: var(--accent-primary);
    transform: translateY(-1px);
  }

  .cta.secondary :global(svg) {
    color: var(--accent-primary);
  }

  @media (max-width: 700px) {
    .container {
      flex-direction: column-reverse;
      text-align: left;
      align-items: flex-start;
      gap: var(--sp-4);
    }

    .info {
      align-items: flex-start;
      width: 100%;
    }

    h1 {
      font-size: var(--fs-2xl);
    }

    .profile-figure {
      align-self: flex-start;
    }

    img {
      width: 88px;
      height: 88px;
    }

    .actions {
      width: 100%;
    }
  }

  @media print {
    h1 {
      font-size: 1.5rem !important;
      color: #000 !important;
    }
    h2 {
      font-size: 0.95rem !important;
      color: #333 !important;
    }
    .summary {
      font-size: 0.82rem !important;
      line-height: 1.45 !important;
      color: #333 !important;
    }
    .profile-figure {
      border: none !important;
    }
    img {
      width: 75px !important;
      height: 75px !important;
      border: 1px solid #d1d5db !important;
      border-radius: 6px !important;
    }
    footer.print {
      font-size: 0.75rem !important;
      color: #374151 !important;
      font-weight: 500 !important;
      margin-top: 4px !important;
    }
  }
</style>
