---
import { basics } from "@cv"
import Section from "@/components/Section.astro"
import Phone from "@/icons/Phone.astro"
import Mail from "@/icons/Mail.astro"
import WorldMap from "@/icons/WorldMap.astro"

const { name, label, image, location, phone, email, summary, cedula, age } = basics
const { city, region, address } = location

const printInfo = [
  cedula ? `C.I. ${cedula}` : null,
  age ? `Edad: ${age}` : null,
  phone ? `Telf: ${phone}` : null,
  email,
  [address, city, region].filter(Boolean).join(" - ")
].filter(Boolean).join(" • ")

const { class: className } = Astro.props;
---

<Section class={`hero-section ${className || ''}`}>
  <div class="container">
    <div class="info">
      <header class="hero-header">
        <h1>{name}</h1>
        <h2>{label}</h2>
      </header>

      <!-- Barra Unificada de Badges Informativos -->
      <div class="hero-badges no-print">
        {(address || city || region) && (
          <div class="badge-capsule" title="Ubicación de residencia">
            <WorldMap />
            <span>{address ? `${address}, ` : ''}{city}, {region}</span>
          </div>
        )}
        {cedula && (
          <div class="badge-capsule highlight" title="Cédula de Identidad">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="13"
              height="13"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect width="18" height="14" x="3" y="5" rx="2" />
              <path d="M7 15h4M15 15h2M7 11h2M13 11h4" />
            </svg>
            <span>C.I. {cedula}</span>
          </div>
        )}
        {age && (
          <div class="badge-capsule" title="Edad">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="13"
              height="13"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
              <circle cx="12" cy="7" r="4" />
            </svg>
            <span>{age}</span>
          </div>
        )}
      </div>

      <p class="summary">{summary}</p>

      <footer class="print">
        {printInfo}
      </footer>

      <footer class="no-print actions">
        {
          email && (
            <a
              href={`mailto:${email}`}
              title={`Enviar un correo a ${name} (${email})`}
              target="_blank"
              rel="noopener noreferrer"
              class="cta primary"
            >
              <Mail />
              <span>Contactar por Correo</span>
            </a>
          )
        }
        {
          phone && (
            <a
              href={`tel:${phone}`}
              title={`Llamar a ${name} al ${phone}`}
              class="cta secondary"
              rel="noopener noreferrer"
            >
              <Phone />
              <span>{phone}</span>
            </a>
          )
        }
      </footer>
    </div>

    <figure class="profile-figure">
      <img src={image} alt={name} width="128" height="128" />
    </figure>
  </div>
</Section>

<style>
  .hero-section {
    background: var(--bg-card);
  }

  .container {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-6);
  }

  .info {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    flex: 1;
  }

  .hero-header {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  h1 {
    font-size: var(--fs-3xl);
    line-height: 1.15;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--text-primary);
  }

  h2 {
    color: var(--accent-primary);
    font-weight: 500;
    font-size: var(--fs-base);
    line-height: 1.4;
  }

  /* Barra Cohesiva de Badges Informativos */
  .hero-badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: 2px;
  }

  .badge-capsule {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--bg-elevated);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-full);
    padding: 4px 11px;
    font-size: var(--fs-xs);
    font-weight: 500;
    color: var(--text-secondary);
    transition: all var(--duration-fast) var(--ease-out);
    white-space: nowrap;
    line-height: 1.35;
  }

  .badge-capsule:hover {
    border-color: var(--accent-primary-border);
    color: var(--text-primary);
    transform: translateY(-1px);
    box-shadow: 0 2px 8px rgba(135, 150, 202, 0.15);
  }

  .badge-capsule :global(svg) {
    width: 13px;
    height: 13px;
    color: var(--accent-primary);
    flex-shrink: 0;
  }

  .badge-capsule.highlight {
    background: var(--accent-primary-subtle);
    border-color: var(--accent-primary-border);
    color: var(--accent-primary);
    font-weight: 600;
  }

  .badge-capsule.highlight :global(svg) {
    color: var(--accent-primary);
  }

  .summary {
    color: var(--text-secondary);
    font-size: var(--fs-sm);
    line-height: 1.6;
    max-width: 95%;
  }

  .profile-figure {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  img {
    aspect-ratio: 1 / 1;
    object-fit: cover;
    width: 8rem;
    height: 8rem;
    border-radius: var(--radius-lg);
    border: 1px solid var(--accent-primary-border);
    background: var(--bg-elevated);
    transition: all var(--duration-fast) var(--ease-out);
  }

  img:hover {
    border-color: var(--accent-primary);
    box-shadow: 0 0 16px rgba(135, 150, 202, 0.25);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    margin-top: var(--sp-1);
    flex-wrap: wrap;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-2);
    height: 38px;
    padding: 0 var(--sp-4);
    border-radius: var(--radius-sm);
    font-size: var(--fs-xs);
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    font-family: inherit;
    white-space: nowrap;
    transition: all var(--duration-fast) var(--ease-out);
  }

  .cta.primary {
    background: var(--accent-primary);
    color: var(--cta-text);
    border: 1px solid var(--accent-primary);
  }

  .cta.primary:hover {
    background: var(--accent-primary-hover);
    border-color: var(--accent-primary-hover);
    transform: translateY(-1px);
  }

  .cta.primary :global(svg) {
    color: var(--cta-text);
  }

  .cta.secondary {
    background: var(--bg-elevated);
    color: var(--text-primary);
    border: 1px solid var(--border-default);
  }

  .cta.secondary:hover {
    background: var(--accent-primary-subtle);
    border-color: var(--accent-primary);
    color: var(--accent-primary);
    transform: translateY(-1px);
  }

  .cta.secondary :global(svg) {
    color: var(--accent-primary);
  }

  @media (max-width: 700px) {
    .container {
      flex-direction: column-reverse;
      text-align: left;
      align-items: flex-start;
      gap: var(--sp-4);
    }

    .info {
      align-items: flex-start;
      width: 100%;
    }

    h1 {
      font-size: var(--fs-2xl);
    }

    .profile-figure {
      align-self: flex-start;
    }

    img {
      width: 88px;
      height: 88px;
    }

    .actions {
      width: 100%;
    }
  }

  /* Vista Impresión / PDF */
  @media print {
    .container {
      align-items: flex-start !important;
      gap: 1.25rem !important;
    }

    h1 {
      font-size: 1.5rem !important;
      color: #000 !important;
    }

    h2 {
      font-size: 0.95rem !important;
      color: #333 !important;
    }

    .summary {
      font-size: 0.82rem !important;
      line-height: 1.45 !important;
      color: #333 !important;
    }

    .profile-figure {
      border: none !important;
      display: flex !important;
      align-items: flex-start !important;
      justify-content: center !important;
      flex-shrink: 0 !important;
    }

    /* Imagen agrandada a 8rem en vista print */
    img {
      width: 8rem !important;
      height: 8rem !important;
      min-width: 8rem !important;
      min-height: 8rem !important;
      border: 1.5px solid #d1d5db !important;
      border-radius: 8px !important;
      object-fit: cover !important;
    }

    footer.print {
      font-size: 0.75rem !important;
      color: #374151 !important;
      font-weight: 500 !important;
      margin-top: 4px !important;
    }
  }
</style>
